<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device through backup or device transfer: the session is bound to this device's Keystore,
     and the activity mirror is re-downloaded from the server after a new sign-in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" /><exclude domain="sharedpref" /><exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" /><exclude domain="file" /><exclude domain="database" /><exclude domain="sharedpref" /><exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
